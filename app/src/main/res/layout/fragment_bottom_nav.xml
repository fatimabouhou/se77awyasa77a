<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="#0F1535"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="16dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠"
            android:textSize="20sp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_nav_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accueil"
            android:textColor="#6C5CE7"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_rdv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅"
            android:textSize="20sp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_nav_rdv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivi"
            android:textColor="#7B8FB0"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_medications"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊"
            android:textSize="20sp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_nav_medications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Médicaments"
            android:textColor="#7B8FB0"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="20sp"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_nav_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil"
            android:textColor="#7B8FB0"
            android:textSize="10sp"/>
    </LinearLayout>

</LinearLayout>