<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Accent bar top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/blue_medium"
            android:layout_marginHorizontal="30dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: Badge Difficulté -->
            <TextView
                android:id="@+id/tv_difficulty_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beginner"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/blue_dark_1"
                android:background="@drawable/bg_badge_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp"
                android:textAllCaps="true"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_tip_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom de l'exercice"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- Info Block: Muscle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_badge_light"
                android:backgroundTint="#F0F7FF"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_health"
                    app:tint="@color/blue_medium"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muscle ciblé"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_muscle_targeted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Biceps"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Short Description (Visible par défaut) -->
            <TextView
                android:id="@+id/tv_tip_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chargement des instructions..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Expanded Section (Hidden by default) -->
            <LinearLayout
                android:id="@+id/layout_expanded_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/separator"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructions détaillées"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_medium"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tv_full_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4" />

                <TextView
                    android:id="@+id/tv_equipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_safety_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sécurité"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#D4812A"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_safety_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.4"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Footer / Toggle -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separator" />

        <LinearLayout
            android:id="@+id/btn_learn_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:paddingHorizontal="20dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_learn_more_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En savoir plus"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/blue_medium"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/iv_arrow_toggle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/blue_medium"
                android:rotation="90" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
