<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── HEADER ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D6E8EE"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon profil"
                android:textColor="#001B48"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_settings"
                android:src="@drawable/ic_settings"
                app:tint="#02457A"
                android:contentDescription="Paramètres"/>
        </RelativeLayout>

        <!-- ── HERO ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_hero"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar"
                android:text="AM"
                android:elevation="4dp"/>

            <TextView
                android:id="@+id/tvNom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ahmed Mansouri"
                android:textColor="#001B48"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ahmed.m@email.com"
                android:textColor="#02457A"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <!-- Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28 ans"
                    android:textColor="#02457A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvGroupeSanguin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groupe A+"
                    android:textColor="#02457A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvMorphologie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="175 cm · 72 kg"
                    android:textColor="#02457A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── STATS ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_card"
                android:padding="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvStatConsultations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#018ABE"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultations"
                    android:textColor="#02457A"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_card"
                android:padding="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvStatMedicaments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#018ABE"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Médicaments"
                    android:textColor="#02457A"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStatOrdonnances"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#018ABE"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ordonnances"
                    android:textColor="#02457A"
                    android:textSize="10sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── LABEL SUIVI ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUIVI PAR SPÉCIALITÉ &amp; MÉDECIN"
            android:textColor="#97CADB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <!-- ── CARTE MÉDICALE DYNAMIQUE ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/containerMaladiesMedecins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- ── LABEL PARAMÈTRES ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PARAMÈTRES"
            android:textColor="#97CADB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <!-- ── CARTE MENU ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp">

            <!-- Mes Ordonnances -->
            <RelativeLayout
                android:id="@+id/itemOrdonnances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_row_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconOrdonnances"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_file"
                    app:tint="#018ABE"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mes ordonnances"
                    android:textColor="#001B48"
                    android:textSize="13sp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/iconOrdonnances"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#97CADB"/>
            </RelativeLayout>

            <!-- Confidentialité -->
            <RelativeLayout
                android:id="@+id/itemConfidentialite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_row_ripple"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconConf"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_shield"
                    app:tint="#018ABE"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confidentialité"
                    android:textColor="#001B48"
                    android:textSize="13sp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/iconConf"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#97CADB"/>
            </RelativeLayout>

            <!-- Déconnexion -->
            <RelativeLayout
                android:id="@+id/itemDeconnexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_row_ripple_last"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconLogout"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_logout"
                    app:tint="#E24B4A"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Se déconnecter"
                    android:textColor="#E24B4A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/iconLogout"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#97CADB"/>
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>