<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/blue_dark_2"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: icon + name/dosage + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Med type icon circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_icon">

                <ImageView
                    android:id="@+id/iv_med_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:contentDescription="Type médicament" />

            </FrameLayout>

            <!-- Name + dosage -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_med_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amoxicilline"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_med_dosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="500 mg · 3×/jour"
                    android:textColor="@color/blue_light_1"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Status badge: Actif / Inactif / Pris -->
            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actif"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_badge_active" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#1597CADB" />

        <!-- Bottom row: next dose time + action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Clock icon + next dose -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                android:alpha="0.7"
                android:contentDescription="Heure"
                app:tint="@color/blue_light_1" />

            <TextView
                android:id="@+id/tv_next_dose_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Prochaine prise : 14:00"
                android:textColor="@color/blue_light_1"
                android:textSize="12sp" />

            <!-- Reminder switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:thumbTint="@color/blue_medium"
                android:trackTint="#40018ABE"
                app:showText="false" />

            <!-- Mark as Taken -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mark_taken"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Pris ✓"
                android:textSize="12sp"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button"
                app:backgroundTint="@color/blue_medium"
                app:cornerRadius="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <!-- Camera / photo row (collapsed by default, toggled in code) -->
        <LinearLayout
            android:id="@+id/ll_photo_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_take_photo"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📷 Photo boîte"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/blue_medium"
                android:textColor="@color/blue_light_1"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call_doctor"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="📞 Médecin"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#4097CADB"
                android:textColor="@color/blue_light_1"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>