<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== HEADER ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bonjour 👋"
                    android:textColor="#64748B"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fatima Bouhou"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_notification"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="23dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/notif"
                    android:scaleType="centerInside"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- ===== CARD RUNNER — DARK NEON ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_runner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="#0D1B2A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:paddingHorizontal="20dp">

                <!-- Label haut -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SANTÉ GLOBALE"
                    android:textColor="#4A90A4"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.25"
                    android:layout_marginBottom="16dp"/>

                <!-- Cercle lumineux autour du runner -->
                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center">

                    <!-- Cercle glow externe (le plus grand, le plus transparent) -->
                    <View
                        android:id="@+id/glow_outer"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_outer"
                        android:alpha="0.4"/>

                    <!-- Cercle glow moyen -->
                    <View
                        android:id="@+id/glow_mid"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_mid"
                        android:alpha="0.6"/>

                    <!-- Cercle glow interne -->
                    <View
                        android:id="@+id/glow_inner"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_inner"
                        android:alpha="0.85"/>

                    <!-- Lottie Runner centré -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_runner"
                        android:layout_width="150dp"
                        android:layout_height="190dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/runner"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>

                </FrameLayout>

                <!-- Score -->
                <TextView
                    android:id="@+id/tv_health_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginTop="16dp"/>

                <!-- Sous-score -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85 / 100"
                    android:textColor="#4A90A4"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Badge néon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excellent"
                    android:textColor="#00D4FF"
                    android:background="@drawable/bg_badge_neon"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== RÉSUMÉ DU JOUR ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Résumé du jour"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/card_stat_rdv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_gradient_blue"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/calendrier"
                    android:scaleType="centerInside"/>

                <view class="android.view.View"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_rdv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rendez-vous"
                    android:textColor="#E0F2FE"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:weightSum="2">

                <LinearLayout
                    android:id="@+id/card_stat_med"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_card_white_premium"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/medicine"
                        android:scaleType="centerInside"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_med_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Médicaments"
                            android:textColor="#64748B"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_stat_ordo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_white_premium"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/rendv"
                        android:scaleType="centerInside"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_ordo_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ordonnances"
                            android:textColor="#64748B"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>