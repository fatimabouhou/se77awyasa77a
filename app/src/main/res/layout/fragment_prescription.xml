<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:text="Mes Ordonnances"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <!-- Bouton Photographier -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_take_prescription_photo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#4A90D9"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📷  Photographier une ordonnance"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </androidx.cardview.widget.CardView>

    <!-- Message si liste vide -->
    <TextView
        android:id="@+id/tv_empty_prescriptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aucune ordonnance enregistrée.\nAppuyez sur le bouton pour en ajouter une."
        android:textColor="#999999"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone"/>

    <!-- Liste des ordonnances -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_prescriptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>