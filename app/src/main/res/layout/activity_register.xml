<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_light_2">

    <View
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/blue_dark_2"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingStart="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Créer un compte"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rejoignez HealthTracker dès aujourd'hui"
            android:textSize="14sp"
            android:fontFamily="@font/nunito_bold"
            android:textColor="@color/blue_light_1"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:background="@color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inscription"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/blue_dark_1"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom complet"
                    android:textSize="12sp"
                    android:textColor="@color/blue_dark_2"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etNom"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Votre nom"
                    android:inputType="textPersonName"
                    android:fontFamily="@font/nunito_bold"
                    android:background="@drawable/input_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/blue_dark_1"
                    android:textColorHint="@color/gray_text"
                    android:imeOptions="actionNext"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="12sp"
                    android:textColor="@color/blue_dark_2"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="exemple@email.com"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/nunito_bold"
                    android:background="@drawable/input_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/blue_dark_1"
                    android:textColorHint="@color/gray_text"
                    android:imeOptions="actionNext"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Âge"
                            android:textSize="12sp"
                            android:textColor="@color/blue_dark_2"
                            android:textStyle="bold"
                            android:fontFamily="@font/nunito_bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etAge"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Ex: 25"
                            android:inputType="number"
                            android:fontFamily="@font/nunito_bold"
                            android:background="@drawable/input_bg"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="14sp"
                            android:textColor="@color/blue_dark_1"
                            android:textColorHint="@color/gray_text"
                            android:imeOptions="actionNext"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Groupe Sanguin"
                            android:textSize="12sp"
                            android:textColor="@color/blue_dark_2"
                            android:textStyle="bold"
                            android:fontFamily="@font/nunito_bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etGroupeSanguin"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Ex: O+"
                            android:inputType="textCapCharacters"
                            android:fontFamily="@font/nunito_bold"
                            android:background="@drawable/input_bg"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="14sp"
                            android:textColor="@color/blue_dark_1"
                            android:textColorHint="@color/gray_text"
                            android:imeOptions="actionNext"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Taille (cm)"
                            android:textSize="12sp"
                            android:textColor="@color/blue_dark_2"
                            android:textStyle="bold"
                            android:fontFamily="@font/nunito_bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etTaille"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Ex: 175"
                            android:inputType="number"
                            android:fontFamily="@font/nunito_bold"
                            android:background="@drawable/input_bg"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="14sp"
                            android:textColor="@color/blue_dark_1"
                            android:textColorHint="@color/gray_text"
                            android:imeOptions="actionNext"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Poids (kg)"
                            android:textSize="12sp"
                            android:textColor="@color/blue_dark_2"
                            android:textStyle="bold"
                            android:fontFamily="@font/nunito_bold"
                            android:layout_marginBottom="6dp"/>
                        <EditText
                            android:id="@+id/etPoids"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="Ex: 70"
                            android:inputType="number"
                            android:fontFamily="@font/nunito_bold"
                            android:background="@drawable/input_bg"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="14sp"
                            android:textColor="@color/blue_dark_1"
                            android:textColorHint="@color/gray_text"
                            android:imeOptions="actionNext"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mot de passe"
                    android:textSize="12sp"
                    android:textColor="@color/blue_dark_2"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:fontFamily="@font/nunito_bold"
                    android:background="@drawable/input_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/blue_dark_1"
                    android:textColorHint="@color/gray_text"
                    android:imeOptions="actionNext"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmer le mot de passe"
                    android:textSize="12sp"
                    android:textColor="@color/blue_dark_2"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:fontFamily="@font/nunito_bold"
                    android:background="@drawable/input_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/blue_dark_1"
                    android:textColorHint="@color/gray_text"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="S'inscrire"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="@font/nunito_bold"
                    android:background="@drawable/btn_primary"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Déjà un compte ? Se connecter"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/blue_medium"
                    android:textSize="13sp"
                    android:layout_gravity="center"
                    android:padding="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>