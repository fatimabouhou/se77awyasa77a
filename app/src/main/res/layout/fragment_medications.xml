<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── HEADER ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Médicaments"
                android:textColor="@color/blue_dark_1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Today summary card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/blue_light_2"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Left: icon + label -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vos prises d'aujourd'hui"
                            android:textColor="@color/blue_medium"
                            android:textSize="12sp"
                            android:letterSpacing="0.06" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_remaining_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textColor="@color/blue_dark_1"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" restants"
                                android:textColor="@color/blue_medium"
                                android:textSize="14sp"
                                android:layout_marginBottom="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Right: progress circle placeholder -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <ProgressBar
                            android:id="@+id/progress_today"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:progress="40"
                            android:progressTint="@color/blue_medium"
                            android:secondaryProgressTint="@color/blue_light_1"
                            android:rotation="-90"
                            android:indeterminate="false" />

                        <TextView
                            android:id="@+id/tv_progress_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2/5"
                            android:textColor="@color/blue_dark_1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Filter tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_filter_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Tab: Tous -->
                    <TextView
                        android:id="@+id/tab_all"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Tous"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_tab_active"
                        android:layout_marginEnd="8dp" />

                    <!-- Tab: Actifs -->
                    <TextView
                        android:id="@+id/tab_active"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Actifs"
                        android:textColor="@color/blue_medium"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_tab_inactive"
                        android:layout_marginEnd="8dp" />

                    <!-- Tab: Pris -->
                    <TextView
                        android:id="@+id/tab_taken"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Pris"
                        android:textColor="@color/blue_medium"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:background="@drawable/bg_tab_inactive" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

        <!-- ── LIST ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_medications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/item_medication" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_help"
                android:alpha="0.25"
                android:contentDescription="Aucun médicament" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aucun médicament enregistré"
                android:textColor="@color/gray_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Appuyez sur + pour en ajouter un"
                android:textColor="#3D6A7B95"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── FAB ── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_medication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Ajouter un médicament"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/blue_medium"
        app:tint="@color/white"
        app:fabSize="normal"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>