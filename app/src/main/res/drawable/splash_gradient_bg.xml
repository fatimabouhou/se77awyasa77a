<?xml version="1.0" encoding="utf-8"?>
<!--
    splash_gradient_bg.xml
    Emplacement : res/drawable/splash_gradient_bg.xml

    Dégradé violet → bleu, similaire à l'image de référence.
    #6C5CE7 (violet vif) en haut → #018ABE (bleu) en bas.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:startColor="#6C5CE7"
        android:centerColor="#4A4BD8"
        android:endColor="#018ABE"
        android:angle="135"
        android:type="linear" />

</shape>